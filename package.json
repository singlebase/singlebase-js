{
  "name": "singlebase-js",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:core": "pnpm --filter @singlebase/core run test",
    "test:sdk": "pnpm --filter @singlebase/singlebase-sdk run test",
    "typecheck": "pnpm -r exec tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\"",
    "verify": "pnpm run format:check && pnpm run build && pnpm run test",
    "example": "pnpm build && python3 -m http.server 4517",
    "test:elements": "pnpm --filter @singlebase/elements run test"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
