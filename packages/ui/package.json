{
  "name": "@singlebase/singlebase-authui",
  "version": "0.1.0",
  "description": "Lit-based embeddable authentication UI components for Singlebase",
  "homepage": "https://singlebase.cloud",
  "type": "module",
  "license": "MIT",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "module": "dist/index.js",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./standalone": "./dist/singlebase-authui.min.js",
    "./package.json": "./package.json"
  },
  "unpkg": "dist/singlebase-authui.min.js",
  "jsdelivr": "dist/singlebase-authui.min.js",
  "sideEffects": true,
  "scripts": {
    "build": "vite build && vite build --config vite.standalone.config.ts && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "web-test-runner \"test/**/*.test.ts\" --node-resolve"
  },
  "dependencies": {
    "@singlebase/core": "workspace:*",
    "@singlebase/auth": "workspace:*",
    "lit": "^3.2.0",
    "@singlebase/singlebase-sdk": "workspace:*"
  },
  "devDependencies": {
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@open-wc/testing": "^4.0.0",
    "@web/dev-server-esbuild": "^1.0.2",
    "@web/test-runner": "^0.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "keywords": [
    "singlebase",
    "auth",
    "web-components",
    "lit",
    "custom-elements",
    "login",
    "signup"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singlebase/singlebase-authui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/singlebase/singlebase-authui/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
