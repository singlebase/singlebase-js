{
  "name": "@singlebase/core",
  "version": "0.5.0",
  "description": "Singlebase client kernel — RPC transport, dispatcher, storage, errors",
  "homepage": "https://singlebase.cloud",
  "type": "module",
  "license": "MIT",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "module": "dist/index.js",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "prepublishOnly": "pnpm run build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "keywords": [
    "singlebase",
    "sdk",
    "rpc",
    "client"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singlebase/singlebase-js.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/singlebase/singlebase-js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
