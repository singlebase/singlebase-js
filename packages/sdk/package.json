{
  "name": "@singlebase/singlebase-sdk",
  "version": "0.1.0",
  "description": "Singlebase service client \u2014 data, files, users, llm and more over one RPC pipe",
  "homepage": "https://singlebase.cloud",
  "type": "module",
  "license": "MIT",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "module": "dist/index.js",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "dependencies": {
    "@singlebase/core": "workspace:*",
    "@singlebase/auth": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "keywords": [
    "singlebase",
    "sdk",
    "data",
    "llm",
    "files",
    "client"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singlebase/singlebase-authui.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/singlebase/singlebase-authui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
